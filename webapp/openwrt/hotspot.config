# OpenWrt UCI Config for Hotspot Voucher System
# Save as: /etc/config/hotspot

config hotspot 'main'
    option enabled '1'
    option api_base 'https://your-vercel-app.vercel.app'
    option api_key 'tarif-hotspot-2024'
    option interface 'br-lan'
    option sync_interval '300'
    option log_file '/var/log/hotspot.log'

config hotspot 'qos'
    option enabled '1'
    option default_download '10240'  # kbps
    option default_upload '2048'     # kbps