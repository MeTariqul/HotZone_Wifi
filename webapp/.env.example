# Neon Database URL - replace with your actual connection string
DATABASE_URL="postgresql://user:password@your-neon-host/neondb?sslmode=require"

# Admin dashboard password (used for session login at /admin)
ADMIN_PASSWORD="change-me-strong-password"

# Shared key for router voucher sync (/api/vouchers/sync)
SYNC_API_KEY="change-me-sync-key"

# Router control (set in Vercel dashboard)
ROUTER_URL="http://your-router-ip"
ROUTER_SECRET="your-router-secret"
